OPENAI_API_KEY=coloque_sua_chave_aqui
OPENAI_MODEL=gpt-4o-mini
# ── Modelo de IA (também trocável pela UI: Configurações > Modelo de IA) ─────
# openai | deepseek. A DeepSeek só faz texto: voz (TTS) e microfone (STT) usam sempre a OpenAI.
LLM_PROVIDER=openai
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
ASSISTANT_NAME=cassandra
ASSISTANT_ALIASES=cassandra,casandra,cassanda
# auto = ouve o microfone quando houver um plugado (e espera em silêncio quando não); mic; text.
# O chat da UI web funciona em qualquer modo.
INPUT_MODE=auto
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
TRANSCRIPTION_LANGUAGE=pt
TRANSCRIPTION_PROMPT=A fala principal e em portugues do Brasil. Preserve nomes proprios e titulos de musicas no idioma original.
# Modo microfone: local = detecta o nome no próprio Pi (Vosk, sem gastar API); openai = transcreve
# toda fala na OpenAI (antigo, gasta créditos o tempo todo)
WAKE_WORD_ENGINE=local
# Transcrição do comando depois do nome: auto (OpenAI se houver chave; se falhar, local), openai, local
TRANSCRIPTION_PROVIDER=auto
VOSK_MODEL_PATH=models/vosk-model-small-pt-0.3
MIC_CHUNK_SECONDS=1
MIC_DEBUG=true
WAKE_TIMEOUT_SECONDS=10
ON_SOUND_PATH=assets/on.mp3
OFF_SOUND_PATH=assets/off.mp3
STARTUP_SOUND_PATH=assets/turn-on.mp3
COMMAND_CAPTURE_MAX_SECONDS=12
COMMAND_SILENCE_CHUNKS=3
COMMAND_END_SILENCE_SECONDS=3.0
VOICE_ENABLED=true
VOICE_LANG=pt-br
VOICE_RATE=165

# ── Outros agentes, sempre via maestro ────────────────────────────────
# A Cassandra não chama outros agentes direto: pede ao maestro (a ponte entre os agentes), que despacha
# (pesquisas na internet vão para o web-agent). auto = usa só quando o maestro responde (checado a cada
# 15 s); false desliga de vez. (O maestro se chamava orchestrator: os nomes antigos ORCHESTRATOR_* ainda valem.)
WEB_SEARCH_ENABLED=auto
# URLs tentadas em ordem, separadas por vírgula. O nome .local do PC (mDNS) continua valendo se o roteador
# trocar o IP; o IP fica de reserva.
MAESTRO_URL=http://desktop-cc6nlck.local:8090,http://192.168.100.52:8090
# O MAESTRO_SHARED_SECRET do .env do maestro
MAESTRO_TOKEN=
# Nome desta assistente no maestro e tempo máximo (s) esperando um pedido
MAESTRO_AGENT_NAME=personal-assistant
# Usuário da Cassandra no web-agent (cada agente tem os próprios logins/cookies/WhatsApp lá)
MAESTRO_WEB_USER=cassandra
MAESTRO_TIMEOUT=120

# ── Spotify ──────────────────────────────────────────────────────────────────
# Client ID do app em developer.spotify.com (login com PKCE: não precisa do client secret). Os dois redirect URIs
# abaixo precisam estar cadastrados no app. Conta Premium é obrigatória para controlar a reprodução.
# Quem toca é o serviço cassandra-spotify (librespot) — ver scripts/raspberry-pi/README.md.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=https://cassandra-app.netlify.app/api/spotify/callback
SPOTIFY_LOCAL_REDIRECT_URI=http://127.0.0.1:8080/api/spotify/callback
SPOTIFY_DEVICE_NAME=Cassandra
